Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /BTL4/

    RewriteRule ^(config|controllers|models|views|routes|core|helpers|middlewares|validates)/ - [F,L]

    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^ index.php [L]
</IfModule>
